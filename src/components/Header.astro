---
import { SITE, PAGES } from '../site.config.mjs';
const current = Astro.url.pathname;
const nav = PAGES.filter((p) => p.path !== '/');
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{SITE.name.split(' ')[0]}<span>{' ' + SITE.name.split(' ').slice(1).join(' ')}</span></a>
    <nav class="site-nav" aria-label="Primary">
      {nav.map((p) => (
        <a href={p.path} aria-current={current === p.path ? 'page' : undefined}>
          {p.path.replace(/\//g, '').replace(/-/g, ' ')}
        </a>
      ))}
    </nav>
  </div>
</header>